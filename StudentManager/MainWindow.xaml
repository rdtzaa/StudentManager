<Window x:Class="StudentManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System" Height="700" Width="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Baris 0: Header -->
            <RowDefinition Height="*"/>
            <!-- Baris 1: Konten Utama -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20">
            <TextBlock Text="Student Management System" Foreground="White" FontSize="26" FontWeight="Bold"/>
        </Border>

        <!-- Konten Utama (Baris 1) -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <!-- Kolom Kiri: Form Input -->
                <ColumnDefinition Width="*"/>
                <!-- Kolom Kanan: Tabel DataGrid -->
            </Grid.ColumnDefinitions>

            <!-- Form Input di Kolom Kiri (Column 0) -->
            <StackPanel Grid.Column="0" Margin="10">
                <TextBox Text="{Binding NIM}" Margin="5"/>
                <TextBox Text="{Binding Nama}" Margin="5"/>
                <ComboBox SelectedItem="{Binding Jurusan}" Margin="5"/>
                <TextBox Text="{Binding Email}" Margin="5"/>
            </StackPanel>

            <!-- DataGrid di Kolom Kanan (Column 1) -->
            <DataGrid Grid.Column="1"
                      ItemsSource="{Binding Students}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      Margin="10"/>
        </Grid>
    </Grid>
</Window>