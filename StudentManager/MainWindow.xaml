<Window x:Class="StudentManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System" Width="1200" Height="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1565C0" CornerRadius="10"
                Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="STUDENT MANAGEMENT SYSTEM" Foreground="White"
                           FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Manage student data" Foreground="White"
                           FontSize="14" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="INPUT MAHASISWA" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="NIM" VerticalAlignment="Center" Margin="0,0,15,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" MaxLength="20" Padding="8,4" Margin="0,0,0,8"
                             Text="{Binding SelectedStudent.NIM, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="Nama" VerticalAlignment="Center" Margin="0,0,15,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" MaxLength="100" Padding="8,4" Margin="0,0,0,8"
                             Text="{Binding SelectedStudent.Nama, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="Jurusan" VerticalAlignment="Center" Margin="0,0,15,8"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Padding="8,4" Margin="0,0,0,8"
                              ItemsSource="{Binding DaftarJurusan}"
                              SelectedItem="{Binding SelectedStudent.Jurusan, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="3" Text="Gender" VerticalAlignment="Center" Margin="0,0,15,8"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Padding="8,4" Margin="0,0,0,8"
                              ItemsSource="{Binding DaftarGender}"
                              SelectedItem="{Binding SelectedStudent.Gender, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="4" Text="Email" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" MaxLength="100" Padding="8,4"
                             Text="{Binding SelectedStudent.Email, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Simpan" Command="{Binding SaveCommand}"/>
                    <Button Content="Hapus" Command="{Binding DeleteCommand}" Style="{StaticResource HapusButtonStyle}"/>
                    <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource ResetButtonStyle}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock Text="INFORMASI" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="Total Mahasiswa"/>
                <TextBlock Text="{Binding TotalStudents}" FontSize="32" FontWeight="Bold" Margin="0,0,0,10"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Informatika"/>
                        <TextBlock Text="{Binding TotalInformatika}" FontSize="24"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Sistem Informasi"/>
                        <TextBlock Text="{Binding TotalSistemInformasi}" FontSize="24"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Laki-laki"/>
                        <TextBlock Text="{Binding TotalLakiLaki}" FontSize="24"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Perempuan"/>
                        <TextBlock Text="{Binding TotalPerempuan}" FontSize="24"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock DockPanel.Dock="Left" Text="Cari mahasiswa" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button DockPanel.Dock="Right" Content="Cari" Command="{Binding SearchCommand}" Padding="25,10"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10" VerticalAlignment="Center"/>
        </DockPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Students}"
                  SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="*"/>
                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*"/>
                <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="2*"/>
                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
